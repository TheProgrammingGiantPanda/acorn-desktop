{
  "name": "electron-shell",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build --config vite.config.ts",
    "dev": "concurrently \"tsc -p tsconfig.main.json --watch\" \"vite --config vite.config.ts\" \"wait-on dist/main/index.js && electron .\"",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "clean": "rimraf dist",
    "package": "electron-builder"
  },
  "dependencies": {
    "@theprogramminggiantpanda/arm-emulator": "workspace:*",
    "@theprogramminggiantpanda/risc-os": "workspace:*",
    "@theprogramminggiantpanda/shared": "workspace:*",
    "electron-log": "^5.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.1",
    "wait-on": "^7.2.0"
  }
}
